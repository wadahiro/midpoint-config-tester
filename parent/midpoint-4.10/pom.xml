<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.wadahiro.midpoint</groupId>
        <artifactId>midpoint-config-tester-parent-common</artifactId>
        <version>0.1.1-SNAPSHOT</version>
    </parent>

    <artifactId>midpoint-config-tester-parent-4.10</artifactId>
    <packaging>pom</packaging>
    <name>midPoint Config Tester parent of config repositories for midPoint 4.10</name>

    <!--
        The parent of a config repository tested on midPoint 4.10: the tester artifact of the line, the line's dependency
        management (the tester's classpath is only the same with midPoint's BOM and the tester's own versions), and
        the agent of the file redirection in the argLine.
    -->
    <properties>
        <midpoint.version>${midpoint410.version}</midpoint.version>
        <tester.argLine>-Xmx3g -Dtester.fork=${surefire.forkNumber} -Duser.language=en --add-exports java.management/sun.management=ALL-UNNAMED -javaagent:${net.bytebuddy:byte-buddy-agent:jar}</tester.argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.evolveum.midpoint</groupId>
                <artifactId>midpoint</artifactId>
                <version>${midpoint.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- the file redirection's version wins over midPoint's: it must read JDK 21 classes -->
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${bytebuddy.version}</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>${bytebuddy.version}</version>
            </dependency>
            <!-- midPoint's own modules the tester depends on (tester/base-4.8/pom.xml): midPoint's BOM does not manage them, so
                 without these the tester's versions would win over midpoint.version (a support build, a fork) -->
            <dependency>
                <groupId>com.evolveum.midpoint.model</groupId>
                <artifactId>model-test</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.model</groupId>
                <artifactId>model-impl</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.model</groupId>
                <artifactId>notifications-impl</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.model</groupId>
                <artifactId>report-impl</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.model</groupId>
                <artifactId>cases-impl</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.model</groupId>
                <artifactId>workflow-impl</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.model</groupId>
                <artifactId>certification-impl</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.provisioning</groupId>
                <artifactId>provisioning-impl</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.provisioning</groupId>
                <artifactId>ucf-impl-builtin</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.repo</groupId>
                <artifactId>task-quartz-impl</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.repo</groupId>
                <artifactId>audit-log-impl</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.repo</groupId>
                <artifactId>security-impl</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.repo</groupId>
                <artifactId>security-enforcer-impl</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.repo</groupId>
                <artifactId>repo-sql-impl-test</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.repo</groupId>
                <artifactId>repo-sqale</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.repo</groupId>
                <artifactId>repo-test-util</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.repo</groupId>
                <artifactId>system-init</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint</groupId>
                <artifactId>midpoint-localization</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <dependency>
                <groupId>com.evolveum.midpoint.infra</groupId>
                <artifactId>test-util</artifactId>
                <version>${midpoint.version}</version>
            </dependency>
            <!-- the versions the tester's own POM gives (tester/base-4.8/pom.xml): they win over midPoint's BOM there -->
            <dependency>
                <groupId>com.unboundid</groupId>
                <artifactId>unboundid-ldapsdk</artifactId>
                <version>${unboundid.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.shibukawa.pgmem</groupId>
                <artifactId>pgmem-native</artifactId>
                <version>${pgmem.version}</version>
                <classifier>${pgmem.classifier}</classifier>
            </dependency>
            <dependency>
                <groupId>com.icegreen</groupId>
                <artifactId>greenmail</artifactId>
                <version>2.1.15</version>
            </dependency>
            <dependency>
                <groupId>io.github.wadahiro.midpoint</groupId>
                <artifactId>midpoint-config-tester-4.10</artifactId>
                <version>${tester.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.wadahiro.midpoint</groupId>
            <artifactId>midpoint-config-tester-4.10</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- the generator of typed names (configured in the common parent) -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
