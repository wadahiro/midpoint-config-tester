<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.wadahiro.midpoint</groupId>
        <artifactId>midpoint-config-tester-root</artifactId>
        <version>0.7.1-SNAPSHOT</version>
    </parent>

    <artifactId>midpoint-config-tester-parent-common</artifactId>
    <packaging>pom</packaging>
    <name>midPoint Config Tester parent of config repositories (common)</name>

    <!--
        What every config repository needs, whatever its line: the typed names generated from its manifest
        (NamesGenerator, a main class of the tester artifact, run by exec-maven-plugin, its output a test source root),
        Surefire (one JVM per line by default, -Dtester.forks=N, the manifest of the repository) and, from the root POM,
        Evolveum's repository and the pgmem classifier profiles. A repository uses one of the per-line parents
        (midpoint-<line>/), which add the tester artifact of the line, its dependency management and its JVM settings:

            <parent>
                <groupId>io.github.wadahiro.midpoint</groupId>
                <artifactId>midpoint-config-tester-parent-4.8</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </parent>

        Properties a repository may set: tester.manifest.file (default midpoint-config-tester.yaml next to the POM),
        tester.names.skip, tester.forks.

        Kotest specs (opt-in, README "Kotest"): kotlin-maven-plugin, the Kotlin stdlib, Kotest and its Kotlin
        libraries are managed here (the libraries at the versions Kotest needs, over midPoint's BOM), and Surefire
        runs *Spec classes too. A repository opts in with

            <dependencies>
                <dependency><groupId>io.github.wadahiro.midpoint</groupId><artifactId>midpoint-config-tester-kotest</artifactId><scope>test</scope></dependency>
                <dependency><groupId>io.kotest</groupId><artifactId>kotest-runner-junit5-jvm</artifactId><scope>test</scope></dependency>
                <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><scope>test</scope></dependency>
            </dependencies>
            <build><plugins>
                <plugin><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-maven-plugin</artifactId></plugin>
            </plugins></build>

        and nothing of Kotlin is resolved by a repository that does not.
    -->
    <modules>
        <module>midpoint-4.0</module>
        <module>midpoint-4.4</module>
        <module>midpoint-4.8</module>
    </modules>

    <profiles>
        <profile>
            <!-- the lines after 4.8 (not LTS): built and tested only with -Pnon-lts -->
            <id>non-lts</id>
            <modules>
                <module>midpoint-4.9</module>
                <module>midpoint-4.10</module>
            </modules>
        </profile>
    </profiles>

    <properties>
        <!-- the parent's version, not the repository's: a config repository has a version of its own -->
        <tester.version>${project.parent.version}</tester.version>
        <!-- the JDKs the tests may run on: each line's parent sets those its midPoint supports; -DskipTests also skips
             the check -->
        <tester.jdk>[11,)</tester.jdk>
        <skipTests>false</skipTests>
        <!-- the repository's manifest: the generator reads its names.package, the tests load it -->
        <tester.manifest.file>${project.basedir}/midpoint-config-tester.yaml</tester.manifest.file>
        <tester.names.dir>${project.build.directory}/generated-test-sources/midpoint-names</tester.names.dir>
        <tester.names.skip>false</tester.names.skip>
        <!-- the per-line parents set it -->
        <tester.argLine>-Xmx3g</tester.argLine>
        <!-- the Kotlin test sources of a repository that opts in -->
        <tester.kotlin.testSourceDir>${project.basedir}/src/test/kotlin</tester.kotlin.testSourceDir>
        <!-- -Dtester.timing=true: the time report of the tester's phases (README, Speed), in the test JVMs -->
        <tester.timing>false</tester.timing>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.wadahiro.midpoint</groupId>
                <artifactId>midpoint-config-tester-kotest</artifactId>
                <version>${tester.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kotest</groupId>
                <artifactId>kotest-runner-junit5-jvm</artifactId>
                <version>${kotest.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kotest</groupId>
                <artifactId>kotest-assertions-core-jvm</artifactId>
                <version>${kotest.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <!-- Kotest's own libraries: midPoint's BOM pins older ones (coroutines 1.6.4 on 4.4, 1.8.1 on 4.8) -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-reflect</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-core-jvm</artifactId>
                <version>${kotlinx-coroutines.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-jdk8</artifactId>
                <version>${kotlinx-coroutines.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-test-jvm</artifactId>
                <version>${kotlinx-coroutines.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-debug</artifactId>
                <version>${kotlinx-coroutines.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-serialization-core-jvm</artifactId>
                <version>1.9.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <!-- Kotlin tests, opt-in (see above): compiled before javac, so it reads the Java sources it may use: the
                         typed names and the repository's Java tests (javac then compiles those against the Kotlin classes) -->
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <configuration>
                        <!-- the release of the line's tests: 11 on 4.0 and 4.4 (their JDK 11 toolchain), 17 on 4.8+ -->
                        <jvmTarget>${maven.compiler.release}</jvmTarget>
                        <args>
                            <arg>-Xjdk-release=${maven.compiler.release}</arg>
                        </args>
                    </configuration>
                    <executions>
                        <execution>
                            <id>kotlin-test-compile</id>
                            <!-- before maven-compiler-plugin's testCompile, after the typed names are generated -->
                            <phase>process-test-sources</phase>
                            <goals>
                                <goal>test-compile</goal>
                            </goals>
                            <configuration>
                                <sourceDirs>
                                    <sourceDir>${tester.kotlin.testSourceDir}</sourceDir>
                                    <sourceDir>${tester.names.dir}</sourceDir>
                                    <sourceDir>${project.build.testSourceDirectory}</sourceDir>
                                </sourceDirs>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.7.0</version>
                </plugin>
                <plugin>
                    <!-- the typed names of the manifest's names.package (Resources, Roles, <Resource>Attrs...); declared by the
                         per-line parents, which have the tester artifact on their class path -->
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <?m2e execute onConfiguration,onIncremental?>
                            <id>midpoint-names</id>
                            <!-- generate-sources: the IDE's "generate sources" runs it too -->
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>java</goal>
                            </goals>
                            <configuration>
                                <mainClass>com.github.wadahiro.midpoint.configtester.names.NamesGenerator</mainClass>
                                <classpathScope>test</classpathScope>
                                <skip>${tester.names.skip}</skip>
                                <arguments>
                                    <argument>${tester.names.dir}</argument>
                                    <argument>${tester.manifest.file}</argument>
                                </arguments>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <!-- the tests run on the JDK that runs Maven: one midPoint supports (tester.jdk of the line's parent).
                     Not with -DskipTests: a build that only compiles and packages may run on another JDK -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>tester-jdk</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <rules>
                                <requireJavaVersion>
                                    <version>${tester.jdk}</version>
                                    <message>midPoint ${midpoint.version} runs its tests on JDK ${tester.jdk}: run Maven on such a JDK (JAVA_HOME, or a mise.toml or .sdkmanrc that pins it)</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>midpoint-names-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${tester.names.dir}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- ${net.bytebuddy:byte-buddy-agent:jar}: the file redirection's agent, for the argLine of 4.8+ -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>agent-path</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- one JVM (one midPoint) for all test classes; -Dtester.forks=N: N JVMs, each its own midPoint,
                         the first to need a deployment loads and caches it, the others restore it -->
                    <!-- Surefire's defaults, and Kotest's *Spec classes (opt-in): without it a spec is skipped silently -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*Spec.java</include>
                    </includes>
                    <forkCount>${tester.forks}</forkCount>
                    <reuseForks>true</reuseForks>
                    <argLine>${tester.argLine}</argLine>
                    <systemPropertyVariables>
                        <tester.manifest>${tester.manifest.file}</tester.manifest>
                        <tester.forks>${tester.forks}</tester.forks>
                        <tester.timing>${tester.timing}</tester.timing>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
