<objectTemplate oid="20000000-0000-0000-0000-00000000d001"
                xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3">
    <name>User template</name>
    <!-- midPoint accepts two mappings with one name; selecting by name cannot tell them apart -->
    <mapping>
        <name>fullName</name>
        <source><path>givenName</path></source>
        <source><path>familyName</path></source>
        <expression><script><code>"$givenName $familyName"</code></script></expression>
        <target><path>fullName</path></target>
    </mapping>
    <mapping>
        <name>fullName</name>
        <source><path>name</path></source>
        <expression><script><code>name?.orig?.toUpperCase()</code></script></expression>
        <target><path>nickName</path></target>
    </mapping>
</objectTemplate>
