<role oid="20000000-0000-0000-0000-00000000c101" xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3">
    <name>Clean</name>
    <inducement>
        <focusMappings>
            <mapping>
                <name>clean-description</name>
                <expression>
                    <script>
                        <code>
                            import com.evolveum.midpoint.xml.ns._public.common.common_3.UserType
                            focus instanceof UserType ? 'user' : 'other'
                        </code>
                    </script>
                </expression>
                <target><path>description</path></target>
            </mapping>
        </focusMappings>
    </inducement>
</role>
