<?xml version="1.0" encoding="UTF-8"?>
<!-- A new user gets a welcome mail, through the mail transport the bulk action 900 configures -->
<systemConfiguration oid="00000000-0000-0000-0000-000000000001"
        xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3">
    <name>SystemConfiguration</name>
    <notificationConfiguration>
        <handler>
            <operation>add</operation>
            <simpleUserNotifier>
                <name>welcome</name>
                <recipientExpression><script><code>requestee?.emailAddress</code></script></recipientExpression>
                <subjectExpression><script><code>'Welcome ' + requestee?.name?.orig</code></script></subjectExpression>
                <bodyExpression><script><code>'Hello'</code></script></bodyExpression>
                <transport>mail</transport>
            </simpleUserNotifier>
        </handler>
    </notificationConfiguration>
</systemConfiguration>
