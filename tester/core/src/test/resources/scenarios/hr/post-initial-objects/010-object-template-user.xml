<?xml version="1.0" encoding="UTF-8"?>
<!--
    The user template: full name and mail address; the role of the department (costCenter, from HR) from the user's
    start date (activation/validFrom, from HR) on. Before the start date the mapping's time constraint is not met: no
    role, so no account; midPoint sets a trigger for the date, and the trigger scanner (or the validity scanner) then
    recomputes the user.
-->
<objectTemplate oid="20000000-0000-0000-0000-00000000b001"
                xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
                xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3">
    <name>User template</name>
    <mapping>
        <name>user-fullName</name>
        <strength>strong</strength>
        <source><path>givenName</path></source>
        <source><path>familyName</path></source>
        <expression><script><code>"$givenName $familyName"</code></script></expression>
        <target><path>fullName</path></target>
    </mapping>
    <mapping>
        <name>user-emailAddress</name>
        <strength>strong</strength>
        <source><path>name</path></source>
        <expression><script><code>"${name}@{{mailDomain}}"</code></script></expression>
        <target><path>emailAddress</path></target>
    </mapping>
    <mapping>
        <name>user-department-role</name>
        <strength>strong</strength>
        <timeFrom>
            <referenceTime>
                <path>$focus/activation/validFrom</path>
            </referenceTime>
        </timeFrom>
        <source><path>costCenter</path></source>
        <condition><script><code>costCenter != null</code></script></condition>
        <expression>
            <assignmentTargetSearch>
                <targetType>RoleType</targetType>
                <filter>
                    <q:equal>
                        <q:path>name</q:path>
                        <expression><script><code>'Dept ' + costCenter</code></script></expression>
                    </q:equal>
                </filter>
            </assignmentTargetSearch>
        </expression>
        <target><path>assignment</path></target>
    </mapping>
</objectTemplate>
