<?xml version="1.0" encoding="UTF-8"?>
<!-- The HR reconciliation for 4.0: no activities, the reconciliation handler on the resource -->
<task oid="20000000-0000-0000-0000-00000000f001"
      xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:mext="http://midpoint.evolveum.com/xml/ns/public/model/extension-3">
    <name>Reconcile HR</name>
    <extension>
        <mext:kind>account</mext:kind>
        <mext:intent>default</mext:intent>
    </extension>
    <ownerRef oid="00000000-0000-0000-0000-000000000002" type="UserType"/>
    <executionStatus>runnable</executionStatus>
    <handlerUri>http://midpoint.evolveum.com/xml/ns/public/model/synchronization/task/reconciliation/handler-3</handlerUri>
    <objectRef oid="20000000-0000-0000-0000-00000000a001" type="ResourceType"/>
    <recurrence>recurring</recurrence>
    <!-- loose: a new thread per run (4.0 binds tightly by default; the tester holds loosely bound tasks only) -->
    <binding>loose</binding>
    <schedule>
        <interval>3600</interval>
    </schedule>
</task>
