<?xml version="1.0" encoding="UTF-8"?>
<!--
    The extension schema of the tester's own tests, as a deployment has it in midPoint's schema directory: the tester
    runs midPoint with -Dtester.extensionSchemaDir (tester/pom.xml points it here). One string item per use in the
    extension tests: the same items extend users, roles and assignments, so that midPoint's merge of extensions into
    the `assignment` variable of a construction shows which one wins. Users also have items of other types, and
    structured ones, for the tests that write them; orgs a multi-valued item, a boolean and an enumeration for the
    GUI's forms.
-->
<xsd:schema elementFormDefault="qualified"
            targetNamespace="http://example.com/xml/ns/tester-extension"
            xmlns:tns="http://example.com/xml/ns/tester-extension"
            xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
            xmlns:a="http://prism.evolveum.com/xml/ns/public/annotation-3"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <xsd:import namespace="http://midpoint.evolveum.com/xml/ns/public/common/common-3"/>

    <xsd:complexType name="UserExtensionType">
        <xsd:annotation>
            <xsd:appinfo>
                <a:extension ref="c:UserType"/>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="site" type="xsd:string" minOccurs="0"/>
            <xsd:element name="badge" type="xsd:string" minOccurs="0"/>
            <xsd:element name="grade" type="xsd:string" minOccurs="0"/>
            <xsd:element name="note" type="xsd:string" minOccurs="0"/>
            <!-- typed and structured items, for the writes of the tests (ExtensionScenarioTest) -->
            <xsd:element name="headcount" type="xsd:int" minOccurs="0"/>
            <xsd:element name="vip" type="xsd:boolean" minOccurs="0"/>
            <xsd:element name="since" type="xsd:dateTime" minOccurs="0"/>
            <xsd:element name="level" type="tns:LevelType" minOccurs="0"/>
            <xsd:element name="tags" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:element name="address" type="tns:AddressType" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:element name="home" type="tns:AddressType" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:simpleType name="LevelType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="low"/>
            <xsd:enumeration value="high"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- a structured value: a container (a:container), with a multi-valued container in it -->
    <xsd:complexType name="AddressType">
        <xsd:annotation>
            <xsd:appinfo>
                <a:container/>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="street" type="xsd:string" minOccurs="0"/>
            <xsd:element name="city" type="xsd:string" minOccurs="0"/>
            <xsd:element name="floor" type="xsd:int" minOccurs="0"/>
            <xsd:element name="phone" type="tns:PhoneType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="PhoneType">
        <xsd:annotation>
            <xsd:appinfo>
                <a:container/>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="kind" type="xsd:string" minOccurs="0"/>
            <xsd:element name="number" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="RoleExtensionType">
        <xsd:annotation>
            <xsd:appinfo>
                <a:extension ref="c:RoleType"/>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="site" type="xsd:string" minOccurs="0"/>
            <xsd:element name="badge" type="xsd:string" minOccurs="0"/>
            <xsd:element name="grade" type="xsd:string" minOccurs="0"/>
            <xsd:element name="note" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <!-- items of orgs for the GUI's forms: a multi-valued one, which they edit in value rows
         (MultiValuedFormScenarioTest), a boolean and an enumeration, drop-downs (ChoiceFormScenarioTest) -->
    <xsd:complexType name="OrgExtensionType">
        <xsd:annotation>
            <xsd:appinfo>
                <a:extension ref="c:OrgType"/>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="tags" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:element name="listed" type="xsd:boolean" minOccurs="0"/>
            <xsd:element name="level" type="tns:LevelType" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="AssignmentExtensionType">
        <xsd:annotation>
            <xsd:appinfo>
                <a:extension ref="c:AssignmentType"/>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="site" type="xsd:string" minOccurs="0"/>
            <xsd:element name="badge" type="xsd:string" minOccurs="0"/>
            <xsd:element name="grade" type="xsd:string" minOccurs="0"/>
            <xsd:element name="note" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
</xsd:schema>
