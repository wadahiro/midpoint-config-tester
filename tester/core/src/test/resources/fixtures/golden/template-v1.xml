<!-- A user template as recorded (see template-v2.xml for the changed one) -->
<objectTemplate oid="10000000-0000-0000-0000-00000000b201" xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3">
    <name>Golden template</name>
    <mapping>
        <name>fullName</name>
        <source><path>givenName</path></source>
        <source><path>familyName</path></source>
        <expression><script><code>"$givenName $familyName"</code></script></expression>
        <target><path>fullName</path></target>
    </mapping>
    <mapping>
        <name>nickName</name>
        <source><path>givenName</path></source>
        <expression><script><code>basic.stringify(givenName)?.toLowerCase()</code></script></expression>
        <target><path>nickName</path></target>
    </mapping>
    <mapping>
        <name>title</name>
        <expression><value>Employee</value></expression>
        <target><path>title</path></target>
    </mapping>
</objectTemplate>
