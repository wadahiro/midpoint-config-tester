<!--
    SCIM service whose classes each have an identifier of their own that it issues on create, apart from the name: Users
    named by userName and identified by userId, Groups named by displayName and identified by groupId. A Group's members
    hold the userIds of its Users. No stored <schema>: the mirror takes the classes from schemaHandling and the
    identifiers from the options (ResourceOptions.classIdentifier(objectClass, attribute)).
-->
<resource oid="10000000-0000-0000-0000-00000000a005"
          xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
          xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
          xmlns:icfc="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/connector-schema-3"
          xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3">
    <name>SCIM issued</name>
    <connectorRef type="ConnectorType">
        <filter>
            <q:equal>
                <q:path>connectorType</q:path>
                <q:value>com.evolveum.polygon.scim.ScimConnector</q:value>
            </q:equal>
        </filter>
    </connectorRef>
    <connectorConfiguration
            xmlns:scim="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/bundle/com.evolveum.polygon.connector-scim/com.evolveum.polygon.scim.ScimConnector">
        <icfc:configurationProperties>
            <scim:baseUrl>https://scim.example.com/v2</scim:baseUrl>
        </icfc:configurationProperties>
    </connectorConfiguration>
    <schemaHandling>
        <objectType>
            <kind>account</kind>
            <intent>default</intent>
            <default>true</default>
            <objectClass>ri:User</objectClass>
            <attribute>
                <ref>ri:userName</ref>
                <outbound><source><path>name</path></source></outbound>
            </attribute>
            <attribute>
                <ref>ri:displayName</ref>
                <outbound><source><path>fullName</path></source></outbound>
            </attribute>
            <association>
                <ref>ri:group</ref>
                <kind>entitlement</kind>
                <intent>group</intent>
                <direction>objectToSubject</direction>
                <associationAttribute>ri:members</associationAttribute>
                <valueAttribute>ri:userId</valueAttribute>
            </association>
        </objectType>
        <objectType>
            <kind>entitlement</kind>
            <intent>group</intent>
            <objectClass>ri:Group</objectClass>
            <attribute>
                <ref>ri:displayName</ref>
            </attribute>
            <attribute>
                <ref>ri:members</ref>
            </attribute>
        </objectType>
    </schemaHandling>
</resource>
