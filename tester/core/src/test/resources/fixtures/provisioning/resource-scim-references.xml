<!--
    The SCIM service of resource-scim-issued.xml as 4.9 and later write it: an associationType (schemaHandling) on a
    simulated reference type (capabilities/configured/references) in place of the object type's association. A
    Group's members.User.value holds the userIds of its Users (objectToSubject).
-->
<resource oid="10000000-0000-0000-0000-00000000a006"
          xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
          xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
          xmlns:icfc="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/connector-schema-3"
          xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3"
          xmlns:cap="http://midpoint.evolveum.com/xml/ns/public/resource/capabilities-3">
    <name>SCIM references</name>
    <connectorRef type="ConnectorType">
        <filter>
            <q:equal>
                <q:path>connectorType</q:path>
                <q:value>com.evolveum.polygon.scim.ScimConnector</q:value>
            </q:equal>
        </filter>
    </connectorRef>
    <connectorConfiguration
            xmlns:scim="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/bundle/com.evolveum.polygon.connector-scim/com.evolveum.polygon.scim.ScimConnector">
        <icfc:configurationProperties>
            <scim:baseUrl>https://scim.example.com/v2</scim:baseUrl>
        </icfc:configurationProperties>
    </connectorConfiguration>
    <schemaHandling>
        <objectType>
            <kind>account</kind>
            <intent>default</intent>
            <default>true</default>
            <objectClass>ri:User</objectClass>
            <attribute>
                <ref>ri:userName</ref>
                <outbound><source><path>name</path></source></outbound>
            </attribute>
            <attribute>
                <ref>ri:displayName</ref>
                <outbound><source><path>fullName</path></source></outbound>
            </attribute>
            <attribute>
                <ref>ri:name.familyName</ref>
                <outbound><source><path>familyName</path></source></outbound>
            </attribute>
        </objectType>
        <objectType>
            <kind>entitlement</kind>
            <intent>group</intent>
            <objectClass>ri:Group</objectClass>
            <attribute>
                <ref>ri:displayName</ref>
            </attribute>
            <attribute>
                <ref>ri:members.User.value</ref>
            </attribute>
        </objectType>
        <associationType>
            <name>groupMembership</name>
            <subject>
                <objectType>
                    <kind>account</kind>
                    <intent>default</intent>
                </objectType>
                <association>
                    <ref>ri:group</ref>
                </association>
            </subject>
            <object>
                <objectType>
                    <kind>entitlement</kind>
                    <intent>group</intent>
                </objectType>
            </object>
        </associationType>
    </schemaHandling>
    <capabilities>
        <configured>
            <cap:references>
                <cap:type>
                    <cap:name>ri:groupMembership</cap:name>
                    <cap:subject>
                        <cap:delineation>
                            <cap:objectClass>ri:User</cap:objectClass>
                        </cap:delineation>
                        <cap:primaryBindingAttributeRef>ri:userId</cap:primaryBindingAttributeRef>
                        <cap:localItemName>ri:group</cap:localItemName>
                    </cap:subject>
                    <cap:object>
                        <cap:delineation>
                            <cap:objectClass>ri:Group</cap:objectClass>
                        </cap:delineation>
                        <cap:primaryBindingAttributeRef>ri:members.User.value</cap:primaryBindingAttributeRef>
                    </cap:object>
                    <cap:direction>objectToSubject</cap:direction>
                </cap:type>
            </cap:references>
        </configured>
    </capabilities>
</resource>
