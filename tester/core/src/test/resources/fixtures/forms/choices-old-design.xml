<!--
    The old design of 4.4's details pages for the drop-downs of choices.xml (ChoiceFormScenarioTest, 4.4 only; imported
    after choices.xml): the lister with a role that turns the new design off (useNewDesign).
-->
<objects xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3">
    <role oid="10000000-0000-0000-0000-0000000f0504">
        <name>form-old-design-role</name>
        <adminGuiConfiguration>
            <useNewDesign>false</useNewDesign>
        </adminGuiConfiguration>
    </role>
    <user oid="10000000-0000-0000-0000-0000000f0505">
        <name>form-old-design-lister</name>
        <assignment>
            <targetRef oid="10000000-0000-0000-0000-0000000f0502" type="RoleType"/>
        </assignment>
        <assignment>
            <targetRef oid="10000000-0000-0000-0000-0000000f0504" type="RoleType"/>
        </assignment>
    </user>
</objects>
