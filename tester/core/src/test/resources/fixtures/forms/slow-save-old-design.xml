<!--
    The old design of 4.4's details pages for slow-save.xml (SlowSaveFormScenarioTest, 4.4 only; imported after
    slow-save.xml): an administrator with a role that turns the new design off (useNewDesign).
-->
<objects xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3">
    <role oid="10000000-0000-0000-0000-0000000f0c04">
        <name>form-slow-old-design-role</name>
        <adminGuiConfiguration>
            <useNewDesign>false</useNewDesign>
        </adminGuiConfiguration>
    </role>
    <user oid="10000000-0000-0000-0000-0000000f0c05">
        <name>form-slow-old-design-admin</name>
        <assignment>
            <targetRef oid="00000000-0000-0000-0000-000000000004" type="RoleType"/>
        </assignment>
        <assignment>
            <targetRef oid="10000000-0000-0000-0000-0000000f0c04" type="RoleType"/>
        </assignment>
    </user>
</objects>
