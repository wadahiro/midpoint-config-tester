<!-- Default logging of the tester runtime (midPoint is very verbose): warnings to target/tester.log. -->
<configuration>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${tester.log:-target/tester.log}</file>
        <encoder><pattern>%d{HH:mm:ss.SSS} [%thread] %-5level \(%logger{46}\): %message%n</pattern></encoder>
    </appender>
    <logger name="com.evolveum.midpoint.util.ClassPathUtil" level="OFF"/>
    <logger name="PROFILING" level="OFF"/>
    <root level="WARN"><appender-ref ref="FILE"/></root>
</configuration>
